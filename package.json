{
  "name": "shyhurricane",
  "version": "1.0.0",
  "description": "Firefox WebExtension that forwards HTTP traffic to the ShyHurricane MCP server.",
  "private": true,
  "scripts": {
    "run": "web-ext run --source-dir .",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest --filename shyhurricane-$npm_package_version.xpi --ignore-files 'package*.json' 'node_modules/**'",
    "test": "jest"
  },
  "devDependencies": {
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "web-ext": "^10.6.0"
  }
}
